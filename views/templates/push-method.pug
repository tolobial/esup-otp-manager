script#push-method(type='text/x-template').
  <div class="space-y-5">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- État 1 : Activation en cours (2 étapes)             -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div v-if="user.methods.push.askActivation">

      <!-- 1. STEPPER VISUEL (2 étapes) -->
      <div class="stepper">
        <div class="step-item" :class="{ skipped: step1Skipped }">
          <div class="step-circle"><span class="step-circle-num">1</span></div>
          <div class="step-line"></div>
          <div class="step-label">{{ messages.api.methods.push.stepper.step1 }}</div>
        </div>
        <div class="step-item">
          <div class="step-circle">2</div>
          <div class="step-label">{{ messages.api.methods.push.stepper.step2 }}</div>
        </div>
      </div>

      <!-- 2. BANDEAU D'INSTRUCTION -->
      <div class="instruction-banner">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 11v5M12 8h.01"></path>
        </svg>
        <span>{{ step1Skipped ? messages.api.methods.push.instruction_banner_skipped : messages.api.methods.push.instruction_banner }}</span>
      </div>

      <!-- 3. CASE À COCHER pour skip étape 1 -->
      <label class="skip-toggle" for="pushSkipCheckbox">
        <input type="checkbox" id="pushSkipCheckbox" v-model="step1Skipped" @change="onSkipChange">
        <span class="skip-toggle-label">
          <strong>{{ messages.api.methods.push.step1.skip_label }}</strong>
        </span>
        <span class="helper-text">{{ messages.api.methods.push.step1.skip_helper }}</span>
      </label>

      <!-- 4. CONTAINER DES 2 CARDS -->
      <div class="steps-container">

        <!-- Card 1 : installer Esup Auth (repliable) -->
        <div class="step-card" :class="{ collapsed: step1Skipped }" @click="step1Skipped && reopenStep1()">
          <div class="step-number"><span class="step-number-text">1</span></div>
          <div class="step-content">
            <h3>{{ messages.api.methods.push.step1.title }}</h3>
            <p v-html="messages.api.methods.push.step1.description.replace('%BRAND_APP%', '<strong>Esup Auth</strong>')"></p>
            <div class="install-buttons">
              <a class="install-btn" href="https://play.google.com/store/apps/details?id=org.esupportail.esupAuth" target="_blank" rel="noopener" title="Esup Auth — Google Play">
                <span class="install-btn-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.8 2.1c-.5.3-.8.8-.8 1.4v17c0 .6.3 1.1.8 1.4l9.6-9.9L3.8 2.1zm11 8.5 2.3 1.1c.8.4.8 1.6 0 2l-2.3 1.1-2.6-2.1 2.6-2.1zm-1.4-1.1L6 3.1l8.5 5 .9.5-2-1zm0 5.9 1.9-.9-.9.5-8.4 4.9 7.4-4.5z"/></svg>
                </span>
                <span class="install-btn-text"><span>DISPONIBLE SUR</span><span>Google Play</span></span>
              </a>
              <a class="install-btn" href="https://apps.apple.com/fr/app/esup-auth/id1563904941" target="_blank" rel="noopener" title="Esup Auth — App Store">
                <span class="install-btn-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2-1.5 2.5-.4 6.3 1 8.3.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.6 1.1 0 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4-.1 0-2.1-.8-2.2-3.2zM14.3 6.6c.6-.7 1-1.7.9-2.6-.8 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.5.9.1 1.8-.5 2.5-1.2z"/></svg>
                </span>
                <span class="install-btn-text"><span>TÉLÉCHARGER DANS</span><span>l'App Store</span></span>
              </a>
            </div>
            <div class="compat-note">
              <strong>{{ messages.api.methods.push.step1.compat_label }} :</strong> {{ messages.api.methods.push.step1.compat_list }}
            </div>
            <div class="collapsed-summary">✓ {{ messages.api.methods.push.step1.collapsed_summary }}</div>
            <button class="reopen-btn" @click.stop="reopenStep1">{{ messages.api.methods.push.step1.reopen_btn }}</button>
          </div>
        </div>

        <!-- Card 2 : pairer l'appareil (deep link mobile / QR desktop + activation manuelle) -->
        <div class="step-card">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>{{ messages.api.methods.push.step2.title }}</h3>

            <!-- Pairer : deep link (mobile) OU QR code (desktop) -->
            <p v-if="user.methods.push.deepLink && infos.mobile"
               v-html="messages.api.methods.push.deeplink_instructions.replace('%DEEPLINK%', user.methods.push.deepLink)"></p>
            <template v-else>
              <p v-html="messages.api.methods.push.qrcode_instructions"></p>
              <div class="push-qrcode mt-3 inline-flex items-center justify-center bg-white border border-gray-200 p-3" v-html="user.methods.push.qrCode"></div>
            </template>

            <!-- Activation manuelle (repliable) -->
            <button type="button" class="manual-key-btn" @click="showManual = !showManual">
              🔧 {{ messages.api.methods.push.step2.manual_btn }}
            </button>
            <div class="bg-gray-50 border border-gray-200 p-4 mt-3" v-if="showManual">
              <div class="text-sm text-gray-700"
                   v-html='messages.api.methods.push.manual_activation_instructions.join("\n").replace("%UID%", user.uid).replace("%ACTIVATION_CODE%", user.methods.push.activationCode).replace("%API_URL%", user.methods.push.api_url)'></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- État 2 : Méthode pairée (askActivation = false)     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div v-else class="bg-white border border-gray-300 shadow-sm p-5">
      <div class="flex items-center gap-4">
        <div class="flex-shrink-0 w-16 h-16 flex items-center justify-center bg-gray-50 border border-gray-200">
          <img src="images/icon-smartphone.svg" alt="" class="w-10 h-10">
        </div>
        <div class="flex-1 min-w-0">
          <p class="text-xs text-gray-500 uppercase tracking-wide mb-1 font-medium">Appareil pairé</p>
          <p class="font-display font-bold text-ua-navy text-base leading-tight">{{user.methods.push.device.platform}}</p>
          <p class="text-sm text-gray-600">{{user.methods.push.device.manufacturer}}</p>
          <p class="text-sm text-gray-500">{{user.methods.push.device.model}}</p>
        </div>
      </div>
    </div>

  </div>
