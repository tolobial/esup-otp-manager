script#totp-method(type='text/x-template').
  <div class="space-y-5">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- État : enregistrement du TOTP en cours (3 étapes)   -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div v-if="user.methods.totp.askActivation">

      <!-- 1. STEPPER VISUEL -->
      <div class="stepper" v-if="!infos.mobile">
        <div class="step-item" :class="{ skipped: step1Skipped }">
          <div class="step-circle"><span class="step-circle-num">1</span></div>
          <div class="step-line"></div>
          <div class="step-label">{{ messages.api.methods.totp.stepper.step1 }}</div>
        </div>
        <div class="step-item">
          <div class="step-circle">2</div>
          <div class="step-line"></div>
          <div class="step-label">{{ messages.api.methods.totp.stepper.step2 }}</div>
        </div>
        <div class="step-item">
          <div class="step-circle">3</div>
          <div class="step-label">{{ messages.api.methods.totp.stepper.step3 }}</div>
        </div>
      </div>

      <!-- 2. BANDEAU D'INSTRUCTION -->
      <div class="instruction-banner" v-if="!infos.mobile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 11v5M12 8h.01"></path>
        </svg>
        <span>{{ step1Skipped ? messages.api.methods.totp.instruction_banner_skipped : messages.api.methods.totp.instruction_banner }}</span>
      </div>

      <!-- 3. CASE À COCHER pour skip étape 1 -->
      <label class="skip-toggle" for="skipCheckbox" v-if="!infos.mobile">
        <input type="checkbox" id="skipCheckbox" v-model="step1Skipped" @change="onSkipChange">
        <span class="skip-toggle-label">
          <strong>{{ messages.api.methods.totp.step1.skip_label }}</strong>
        </span>
        <span class="helper-text">{{ messages.api.methods.totp.step1.skip_helper }}</span>
      </label>

      <!-- 4. CONTAINER DES 3 CARDS -->
      <div class="steps-container">

        <!-- Card 1 : installer l'application (repliable) -->
        <div class="step-card" v-if="!infos.mobile" :class="{ collapsed: step1Skipped }" @click="step1Skipped && reopenStep1()">
          <div class="step-number"><span class="step-number-text">1</span></div>
          <div class="step-content">
            <h3>{{ messages.api.methods.totp.step1.title }}</h3>
            <p v-html="messages.api.methods.totp.step1.description.replace('%BRAND_APP%', '<strong>Esup Auth</strong>')"></p>
            <div class="install-buttons">
              <a class="install-btn" href="https://play.google.com/store/apps/details?id=org.esupportail.esupAuth" target="_blank" rel="noopener" title="Esup Auth — Google Play">
                <span class="install-btn-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.8 2.1c-.5.3-.8.8-.8 1.4v17c0 .6.3 1.1.8 1.4l9.6-9.9L3.8 2.1zm11 8.5 2.3 1.1c.8.4.8 1.6 0 2l-2.3 1.1-2.6-2.1 2.6-2.1zm-1.4-1.1L6 3.1l8.5 5 .9.5-2-1zm0 5.9 1.9-.9-.9.5-8.4 4.9 7.4-4.5z"/></svg>
                </span>
                <span class="install-btn-text"><span>DISPONIBLE SUR</span><span>Google Play</span></span>
              </a>
              <a class="install-btn" href="https://apps.apple.com/fr/app/esup-auth/id1563904941" target="_blank" rel="noopener" title="Esup Auth — App Store">
                <span class="install-btn-icon">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.1.8-.6 0-1.6-.7-2.7-.7-1.4 0-2.7.8-3.4 2-1.5 2.5-.4 6.3 1 8.3.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.6 1.1 0 1.8-1 2.5-2 .8-1.2 1.1-2.3 1.1-2.4-.1 0-2.1-.8-2.2-3.2zM14.3 6.6c.6-.7 1-1.7.9-2.6-.8 0-1.9.6-2.5 1.3-.5.6-1 1.6-.9 2.5.9.1 1.8-.5 2.5-1.2z"/></svg>
                </span>
                <span class="install-btn-text"><span>TÉLÉCHARGER DANS</span><span>l'App Store</span></span>
              </a>
            </div>
            <div class="compat-note" v-if="messages.api.methods.totp.step1.compat_list">
              <strong>{{ messages.api.methods.totp.step1.compat_label }} :</strong> {{ messages.api.methods.totp.step1.compat_list }}
            </div>
            <div class="collapsed-summary">✓ {{ messages.api.methods.totp.step1.collapsed_summary }}</div>
            <button class="reopen-btn" @click.stop="reopenStep1">{{ messages.api.methods.totp.step1.reopen_btn }}</button>
          </div>
        </div>

        <!-- Card 2 : scanner le QR code + clé manuelle -->
        <div class="step-card">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3 v-if="!infos.mobile">{{ messages.api.methods.totp.step2.title }}</h3>
            <p v-if="!infos.mobile" v-html="messages.api.methods.totp.step2.description"></p>
            <div class="qr-area">
              <!-- Desktop : QR direct + clé via showManualKey (inchangé) -->
              <template v-if="!infos.mobile">
                <div class="qr-img" v-html="user.methods.totp.qrCode"></div>
                <div>
                  <p>{{ messages.api.methods.totp.step2.manual_key_label }}</p>
                  <button type="button" class="manual-key-btn" @click="showManualKey = !showManualKey">
                    🔑 {{ messages.api.methods.totp.step2.manual_key_btn }}
                  </button>
                  <div class="manual-key-display" v-if="showManualKey">
                    <span v-html="messages.api.methods.totp.step2.manual_key_intro"></span> {{ user.methods.totp.secret }}
                  </div>
                </div>
              </template>
              <!-- Mobile : stepper 2 étapes (étape 1 = installer Esup Auth) -->
              <div v-if="infos.mobile" class="w-full space-y-4">
                <!-- Étape 1 : installer Esup Auth -->
                <div v-if="currentStep === 1" class="space-y-4">
                  <h4 class="font-display font-bold text-ua-navy">{{ messages.api.methods.totp.step2.mobile_install_title }}</h4>
                  <p class="text-sm text-gray-500">{{ messages.api.methods.totp.step2.mobile_install_desc }}</p>
                  <a class="inline-flex items-center justify-center gap-2 w-full px-4 py-3 bg-ua-navy text-white text-sm font-medium"
                     :href="infos.EsupAuth[infos.mobile]" target="_blank">{{ messages.api.methods.totp.step2.mobile_download_btn }}</a>
                  <p class="text-xs text-gray-500">{{ messages.api.methods.totp.step2.mobile_already_installed }}</p>
                  <button type="button" class="w-full mt-4 px-4 py-3 bg-ua-navy text-white text-sm font-medium" @click="currentStep = 2">{{ messages.api.methods.totp.step2.mobile_continue }}</button>
                </div>
                <!-- Étape 2 : clé + Ouvrir + code (retravaillée au Cran 2) -->
                <div v-if="currentStep === 2" class="space-y-4">
                  <h4 class="font-display font-bold text-ua-navy">{{ messages.api.methods.totp.step2.mobile_step1_title }}</h4>
                  <div class="text-center border-2 border-gray-200 p-4 space-y-3">
                    <p class="text-xs font-medium text-gray-500">{{ messages.api.methods.totp.step2.mobile_key_label }}</p>
                    <p class="font-mono text-base text-ua-navy break-words">{{ formattedSecret }}</p>
                    <button type="button" class="manual-key-btn" @click="copyKey">📋 {{ messages.api.methods.totp.step2.copy_key }}</button>
                    <p class="text-xs text-gray-500">{{ messages.api.methods.totp.step2.mobile_key_hint }}</p>
                  </div>
                  <a class="inline-flex items-center justify-center gap-2 w-full px-4 py-3 bg-ua-navy text-white text-sm font-medium"
                     v-if="user.methods.totp.deepLink"
                     :href="user.methods.totp.deepLink">{{ messages.api.methods.totp.step2.open_app }}</a>
                  <a class="mt-2 text-xs text-ua-blue underline block text-center"
                     :href="infos.EsupAuth[infos.mobile]" target="_blank">{{ messages.api.methods.totp.step2.download_esupauth }}</a>
                  <form @submit.prevent="validate">
                    <input type="text"
                           class="otp-field"
                           inputmode="numeric"
                           v-model="user.methods.totp.validation_code"
                           id="totpCode-input"
                           required
                           maxlength="6"
                           pattern="[0-9]{6}"
                           autocomplete="one-time-code"
                           :placeholder="messages.api.methods.totp.step3.field_placeholder">
                    <button type="submit" class="validate-btn">
                      <span>{{ messages.api.methods.totp.step3.validate_btn }}</span>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                      </svg>
                    </button>
                  </form>
                  <button type="button" class="mt-3 text-xs text-ua-blue underline" @click="currentStep = 1">{{ messages.api.methods.totp.step2.mobile_back }}</button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 3 : saisir le code — desktop uniquement (le mobile a sa copie dans l'étape 2 ci-dessus) -->
        <div class="step-card" v-if="!infos.mobile">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>{{ messages.api.methods.totp.step3.title }}</h3>
            <p v-html="messages.api.methods.totp.step3.description"></p>
            <form @submit.prevent="validate">
              <input type="text"
                     class="otp-field"
                     inputmode="numeric"
                     v-model="user.methods.totp.validation_code"
                     id="totpCode-input"
                     required
                     maxlength="6"
                     pattern="[0-9]{6}"
                     autocomplete="one-time-code"
                     :placeholder="messages.api.methods.totp.step3.field_placeholder">
              <button type="submit" class="validate-btn">
                <span>{{ messages.api.methods.totp.step3.validate_btn }}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- État : pas encore enregistré → bouton générer       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div v-else class="bg-white border border-gray-300 shadow-sm p-8 text-center">
      <p class="text-sm text-gray-500 mb-5">
        Cliquez pour générer une nouvelle clé TOTP et configurer Esup Auth.
      </p>
      <button type="button"
              @click="generate_totp"
              class="inline-flex items-center gap-2 px-6 py-3 bg-ua-navy hover:bg-ua-indigo text-white font-semibold text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ua-navy focus-visible:ring-offset-2">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
        </svg>
        <span>{{messages.api.action.generate_qrcode}}</span>
      </button>
    </div>

  </div>
