script#passcode_grid-method(type='text/x-template').
  <div class="space-y-5">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- Bandeau d'avertissement (note de la méthode)         -->
    <!-- (AJOUT UX : extrait du <caption> de la table pour    -->
    <!-- une visibilité bien meilleure)                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <div v-if="messages.api.methods.passcode_grid.note" class="bg-ua-crimson text-white px-4 py-3 flex gap-3" role="alert">
      <svg class="w-5 h-5 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
      </svg>
      <p class="text-sm leading-relaxed" v-html="messages.api.methods.passcode_grid.note"></p>
    </div>

    <!-- Grille de codes (si générée) -->
    <div v-if="user.methods.passcode_grid.grid" class="bg-white border border-gray-300">

      <!-- En-tête : titre + bouton imprimer -->
      <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between gap-3 print:hidden">
        <h4 class="font-semibold text-ua-navy text-sm">Grille de codes</h4>
        <div class="flex items-center gap-2">
          <button type="button"
                  @click="printAs('sheet')"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-ua-blue hover:bg-ua-indigo text-white font-semibold text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ua-blue focus-visible:ring-offset-2"
                  aria-label="Imprimer la grille de codes au format A4">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z"/>
            </svg>
            <span>Imprimer (A4)</span>
          </button>
          <button type="button"
                  @click="printAs('card')"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-ua-navy hover:bg-ua-indigo text-white font-semibold text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ua-navy focus-visible:ring-offset-2"
                  aria-label="Imprimer la grille de codes au format carte (CR80)">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path stroke-linecap="round" d="M3 9.5h18"></path>
            </svg>
            <span>Carte</span>
          </button>
        </div>
      </div>

      <!-- Grille (table sémantique avec en-têtes lignes/colonnes) — écran uniquement -->
      <div class="passcode_grid-method-codes overflow-x-auto print:hidden">
        <table class="w-full" aria-label="Grille de codes de passe">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-3 py-2 w-10" aria-hidden="true"></th>
              <th v-for="(code, colIndex) in user.methods.passcode_grid.grid[0]"
                  scope="col"
                  :key="'col-' + colIndex"
                  class="px-3 py-2 text-xs font-display font-bold text-ua-blue uppercase tracking-wide text-center">
                {{ colIndex + 1 }}
              </th>
            </tr>
          </thead>
          <tbody>
            <tr v-for="(line, lineIndex) in user.methods.passcode_grid.grid"
                :key="'row-' + lineIndex"
                class="border-b border-gray-100 last:border-b-0 hover:bg-blue-50/30 transition-colors">
              <th :key="'line-' + lineIndex"
                  scope="row"
                  class="px-3 py-2 text-xs font-display font-bold text-ua-blue uppercase tracking-wide bg-gray-50 text-center">
                {{ String.fromCharCode(lineIndex + 'A'.charCodeAt(0)) }}
              </th>
              <td v-for="(code, colIndex) in line"
                  :key="'cell-' + colIndex"
                  class="px-3 py-2 font-mono text-sm text-ua-navy text-center select-all tabular-nums">
                {{ code }}
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- ░░ Feuille imprimable — grille de codes (custom UA).
           printMode='sheet' → A4 brandée ; printMode='card' → carte CR80. ░░ -->
      <div class="ua-print-sheet hidden print:block"
           :class="printMode === 'card' ? 'ua-print--card' : 'ua-print--sheet'"
           aria-hidden="true">

        <!-- Format A4 brandé -->
        <div class="ua-print-a4">
          <header class="ua-print-head">
            <img src="/images/logo_ua.png" alt="Université des Antilles" class="ua-print-logo">
            <div class="ua-print-org">
              <span class="ua-print-org-name">Université des Antilles</span>
              <span class="ua-print-org-sub">Direction du Numérique — DSIN</span>
            </div>
            <span class="ua-print-tag">MFA · {{ messages.api.print.grid_title }}</span>
          </header>
          <h1 class="ua-print-title">{{ messages.api.print.grid_title }}</h1>
          <p class="ua-print-intro">{{ messages.api.print.grid_intro }}</p>
          <table class="ua-print-grid">
            <thead>
              <tr>
                <th></th>
                <th v-for="(code, colIndex) in user.methods.passcode_grid.grid[0]" :key="'pcol-' + colIndex">{{ colIndex + 1 }}</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="(line, lineIndex) in user.methods.passcode_grid.grid" :key="'prow-' + lineIndex">
                <th>{{ String.fromCharCode(lineIndex + 'A'.charCodeAt(0)) }}</th>
                <td v-for="(code, colIndex) in line" :key="'pcell-' + colIndex">{{ code }}</td>
              </tr>
            </tbody>
          </table>
          <div class="ua-print-security">{{ messages.api.print.security }}</div>
          <footer class="ua-print-foot">{{ messages.api.print.footer }}</footer>
        </div>

        <!-- Format carte CR80 (85,6 × 54 mm) — mini-branding + grille compacte, à découper -->
        <div class="ua-print-cr80">
          <div class="ua-print-cr80-head">
            <img src="/images/logo_ua.png" alt="Université des Antilles" class="ua-print-cr80-logo">
            <span class="ua-print-cr80-tag">UA · MFA</span>
          </div>
          <table class="ua-print-cr80-grid">
            <thead>
              <tr>
                <th></th>
                <th v-for="(code, colIndex) in user.methods.passcode_grid.grid[0]" :key="'ccol-' + colIndex">{{ colIndex + 1 }}</th>
              </tr>
            </thead>
            <tbody>
              <tr v-for="(line, lineIndex) in user.methods.passcode_grid.grid" :key="'crow-' + lineIndex">
                <th>{{ String.fromCharCode(lineIndex + 'A'.charCodeAt(0)) }}</th>
                <td v-for="(code, colIndex) in line" :key="'ccell-' + colIndex">{{ code }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Date de dernière génération -->
    <p v-if="user.methods.passcode_grid.generation_date" class="text-xs text-gray-500 italic print:hidden">
      {{ messages.api.methods.passcode_grid.generation_date.replace("%DATE%", generationDateString) }}
    </p>

    <!-- Bouton (re)générer -->
    <div class="flex justify-center pt-2 print:hidden">
      <button type="button"
              @click="generate_passcode_grid"
              class="inline-flex items-center gap-2 px-6 py-3 bg-ua-navy hover:bg-ua-indigo text-white font-semibold text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ua-navy focus-visible:ring-offset-2">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
        </svg>
        <span>{{ messages.api.action.generate_codes }}</span>
      </button>
    </div>

  </div>
